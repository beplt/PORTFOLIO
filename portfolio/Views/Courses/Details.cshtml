@model CourseDetails
@{
    ViewData["Title"] = Model.Course.Title;
}

<h1 class="mb-1">@Model.Course.Title</h1>
<p class="text-muted">@Model.Course.Code · @(Model.Course.Term ?? "")</p>
<p>@(Model.Course.Description ?? "")</p>

<h2 class="h5 mt-4">Projects</h2>
@if (Model.Projects.Count == 0)
{
    <p>No projects in this course yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var project in Model.Projects)
        {
            <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.ProjectId"
               class="list-group-item list-group-item-action">
                <strong>@project.Title</strong>
                <div class="text-muted small">@(project.Summary ?? "")</div>
            </a>
        }
    </div>
}

<a asp-action="Index" class="btn btn-link px-0 mt-3">Back to courses</a>