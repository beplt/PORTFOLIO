@model List<Project>
@{
    ViewData["Title"] = "Editor: projects";
    var codes = (Dictionary<long, string>)ViewBag.CourseCodes;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Editor: projects</h1>
        <p class="text-muted mb-0">@Model.Count projects</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a project</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Course</th>
            <th>Title</th>
            <th>Started</th>
            <th style="width:16rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@(codes.TryGetValue(project.CourseId, out var code) ? code : "-")</td>
                <td>@project.Title</td>
                <td>@project.StartedOn.ToString("yyyy-MM-dd")</td>
                <td class="text-end text-nowrap">
                    <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-primary">View</a>
                    <a asp-action="Edit" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/editor/courses" class="btn btn-link px-0">Editor: courses</a>

<a href="/editor/projects" class="btn btn-link">Editor: projects</a>