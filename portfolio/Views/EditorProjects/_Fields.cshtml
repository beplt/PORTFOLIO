@model ProjectForm

<div class="mb-3">
    <label asp-for="CourseId" class="form-label">Course</label>
    <select asp-for="CourseId" asp-items="(SelectList)ViewBag.Courses" class="form-select"></select>
    <span asp-validation-for="CourseId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Summary" class="form-label"></label>
    <input asp-for="Summary" class="form-control" />
    <span asp-validation-for="Summary" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
</div>

<div class="mb-3">
    <label asp-for="RepoUrl" class="form-label">Code link</label>
    <input asp-for="RepoUrl" class="form-control" />
    <span asp-validation-for="RepoUrl" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="VideoUrl" class="form-label">YouTube link</label>
    <input asp-for="VideoUrl" class="form-control" />
    <span asp-validation-for="VideoUrl" class="text-danger"></span>
</div>

<div class="row">
    <div class="col mb-3">
        <label asp-for="StartedOn" class="form-label">Started on</label>
        <input asp-for="StartedOn" type="date" class="form-control" />
        <span asp-validation-for="StartedOn" class="text-danger"></span>
    </div>
    <div class="col mb-3">
        <label asp-for="CompletedOn" class="form-label">Completed on</label>
        <input asp-for="CompletedOn" type="date" class="form-control" />
        <span asp-validation-for="CompletedOn" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="ImageUrls" class="form-label">Image links, one per line</label>
    <textarea asp-for="ImageUrls" class="form-control" rows="5"></textarea>
    <span asp-validation-for="ImageUrls" class="text-danger"></span>
</div>